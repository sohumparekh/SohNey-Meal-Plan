# Postgres. On Vercel use Supabase's "Transaction pooler" connection string (port 6543).
DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Login: the shared household passcode, and a long random string used to sign the login cookie.
HOUSEHOLD_PASSCODE=
SESSION_SECRET=

# Protects /api/cron/tick and /api/setup. Long random string; also goes into supabase/cron.sql.
CRON_SECRET=

# Web push. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Claude API, only for drafting new dishes and reading free-text cook replies.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# Phase 2 only: set to cloud_api once the WhatsApp Business Cloud API is set up.
# WHATSAPP_MODE=wa_link
